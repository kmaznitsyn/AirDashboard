{
  "expo": {
    "name": "AirDashboard",
    "slug": "airdashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aa7de3fe-22a7-4a86-a417-59415be44a5d"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F4F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.airdashboard",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Air Dashboard uses your location to show local air quality and weather conditions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F4F8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.airdashboard",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Air Dashboard uses your location to show local air quality and weather."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1976D2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aa7de3fe-22a7-4a86-a417-59415be44a5d"
      }
    },
    "owner": "mykolka"
  }
}
